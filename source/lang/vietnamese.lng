"New content: {1} new podcast episodes and {2} new YouTube videos." = "Có nội dung mới: {1} tập podcast mới và {2} video YouTube mới."
"New content: {1} new podcast episodes." = "Có nội dung mới: {1} tập podcast mới."
"New content: {1} new YouTube videos." = "Có nội dung mới: {1} video YouTube mới."
