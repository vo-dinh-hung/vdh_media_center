"Longer seek step" = "Bước tua dài hơn"
"Show percentage played" = "Cho biết phần trăm đã phát"
"Go to a specific time" = "Đi đến thời điểm cụ thể"
"Copy the track title" = "Sao chép tên bài"
"Open the equalizer" = "Mở bộ chỉnh âm"
"Show file information" = "Xem thông tin tệp"
"Next file / Auto-play on or off" = "Tệp kế tiếp / Bật tắt tự động phát"
"Previous file" = "Tệp trước"
