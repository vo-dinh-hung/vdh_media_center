"View changelog" = "Xem nhật ký thay đổi"
"Check for updates" = "Kiểm tra cập nhật"
"Check for yt-dlp updates" = "Kiểm tra cập nhật yt-dlp"

; ---- Version 3.3: Podcasts, chapters, voice enhancement, search sources ----
"&Jump" = "&Nhảy tới"
"&New episodes" = "Tập &mới"
"&Open" = "&Mở"
"&Play" = "&Phát"
"&Search" = "Tìm &kiếm"
"&Subscribe (Ctrl+D)" = "Đăng &ký theo dõi (Ctrl+D)"
"&Unsubscribe (Delete)" = "&Hủy theo dõi (Delete)"
"Announce the chapter title when a new chapter starts" = "Đọc tên chương khi một chương mới bắt đầu"
"Cannot get the stream of this item from its website." = "Không lấy được luồng phát của mục này từ trang web."
"Cannot read this podcast. Check the link and your internet connection." = "Không đọc được podcast này. Hãy kiểm tra liên kết và kết nối internet."
