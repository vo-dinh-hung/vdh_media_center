"Video description" = "Mô tả video"
"Video comments" = "Bình luận video"
"Add to play queue" = "Thêm vào hàng đợi phát"
"Open the play queue" = "Mở hàng đợi phát"
"Open the Options menu" = "Mở menu Tùy chọn"
"Next video" = "Video kế tiếp"
"Previous video" = "Video trước"
